/node_modules
/public/hot
/public/storage
/storage/*.key
/storage/app/receipts/*
!/storage/app/receipts/.gitkeep
/storage/app/private/*
!/storage/app/private/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/vendor
*.sqlite
*.sqlite-journal
*.log
composer_debug.log
test.php
/storage/framework/testing/*
/scratch
NUL
.phpunit.result.cache
.vite
.DS_Store
Thumbs.db

# Permitir archivos .env y .htaccess
!.env
!.env.*
!.htaccess
!public/.htaccess

# Archivos comprimidos restringidos
*.zip
*.rar
*.tar
*.tar.gz
*.tgz
*.7z
*.gz
*.bz2
